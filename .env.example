# Copy values into .env.local for local development and into server environment settings for production.
# Never commit real credentials. Retain your existing Spotify, Supabase and ADMIN_PIN values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PIN=
# Optional: independent, long random signing secret. If omitted, TWITCH_CLIENT_SECRET is used.
ADMIN_SESSION_SECRET=

# Twitch chat polls. Use the canonical HTTPS origin without a trailing path.
APP_URL=https://www.wewannaflyanyway-music.ru
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
